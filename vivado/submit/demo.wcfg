<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="top_tb_1000_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="top_tb_1000" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="382,000 ps"></ZoomStartTime>
      <ZoomEndTime time="412,000 ps"></ZoomEndTime>
      <Cursor1Time time="401,975 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="215"></NameColumnWidth>
      <ValueColumnWidth column_width="60"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="15" />
   <wvobject type="divider" fp_name="divider45">
      <obj_property name="label">Organizer top_tb : input</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/top_tb_1000/clk" type="logic">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
      <obj_property name="label">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/top_tb_1000/rst_n" type="logic">
      <obj_property name="DisplayName">label</obj_property>
